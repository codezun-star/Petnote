# ===========================================================================
# Everything from here to the Resend block goes in VERCEL (and .env.local).
#
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle at BUILD
# time. That means two things: never put a secret behind that prefix, and
# changing one only takes effect after a redeploy, not a restart.
# ===========================================================================

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for metadata, emails and the URL encoded into Emergency Mode QR codes.
NEXT_PUBLIC_SITE_URL=https://petnote.codezun.com

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser-safe key. Supabase is midway through renaming these, so either
# variable name works — use whichever matches what your dashboard shows:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY         legacy JWT, "anon"        (eyJhbGci...)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  current, "publishable"    (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Bypasses row level security entirely — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
#
# Required for login: usernames are resolved to emails through a function only
# the service role may execute.
#
# Dashboard → Project Settings → API Keys. In the current key system the
# "Secret keys" section starts empty — click "Create new secret key", and copy
# it immediately because it is shown only once. The legacy "service_role" JWT
# lives under the "Legacy API keys" tab. Either works:
#   SUPABASE_SERVICE_ROLE_KEY  legacy JWT, "service_role"  (eyJhbGci...)
#   SUPABASE_SECRET_KEY        current, "secret"           (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---------------------------------------------------------------------------
# Paddle
# ---------------------------------------------------------------------------
# "sandbox" while testing, "production" when live.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token

# Petnote's Pro prices. This Paddle account also serves another product, so the
# webhook handler uses these ids to decide which events belong to Petnote —
# events referencing any other price are ignored.
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ID_YEARLY=pri_...

# Optional second filter: match on product instead of (or as well as) price.
PADDLE_PRODUCT_ID=pro_...

# Price shown on the landing page. Purely cosmetic — Paddle remains the source
# of truth for what is actually charged. Leave unset to show non-numeric copy
# instead of a figure.
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY=$5
NEXT_PUBLIC_PRO_PRICE_YEARLY_DISPLAY=$45

# Server-only.
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-signing-secret

# ===========================================================================
# DO NOT put the rest in Vercel — it would do nothing there.
#
# Reminder emails are sent by the Supabase Edge Function, which has its own
# secret store and never sees Vercel's environment:
#
#   supabase secrets set \
#     RESEND_API_KEY=re_... \
#     REMINDER_FROM_EMAIL="Petnote <reminders@petnote.codezun.com>" \
#     SITE_URL=https://petnote.codezun.com
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into edge functions
# automatically, so they are not repeated here.
# ===========================================================================
RESEND_API_KEY=re_...
REMINDER_FROM_EMAIL=Petnote <reminders@petnote.codezun.com>
SITE_URL=https://petnote.codezun.com
